{
  "name": "@hypurr/vaults",
  "version": "0.1.0",
  "description": "React hooks for Euler vault data on HyperEVM",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": "^18",
    "viem": "^2.0.0",
    "wagmi": "^2.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@tanstack/react-query": "^5.90.20",
    "@testing-library/react": "14.0.0",
    "@types/react": "^18.2.14",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/ui": "^4.0.18",
    "jsdom": "^28.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.15",
    "tsup": "^8.0.0",
    "typescript": "^5.6.2",
    "viem": "^2.45.1",
    "vite": "^6.4.1",
    "vitest": "^1.6.1",
    "wagmi": "^3.4.2"
  },
  "keywords": [
    "hypurr",
    "oracle",
    "react",
    "hooks"
  ],
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
